{
  "_version": "1.86.0",
  "sap.app": {
    "id": "bsx.hrx.hrx2026",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.29.0",
      "toolsId": "66332a0b-a8e4-42c2-8280-b88db765ceb1"
    },
    "dataSources": {
      "hrxService": {
        "uri": "hrx/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/hrx/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "hrxsuite-display": {
          "semanticObject": "hrxsuite",
          "action": "display",
          "title": "{{hrxsuite-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.150.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "bsx.hrx.hrx2026.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/hrx.css"
        },
        {
          "uri": "css/hrx-ui5.css"
        },
        {
          "uri": "css/hrx-mobile.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "async": true
      },
      "routes": [
        {
          "name": "home",
          "pattern": ""
        },
        {
          "name": "timesheet",
          "pattern": "timesheet"
        },
        {
          "name": "leave",
          "pattern": "leave"
        },
        {
          "name": "teamcal",
          "pattern": "teamcalendar"
        },
        {
          "name": "mydocs",
          "pattern": "policies"
        },
        {
          "name": "explorer",
          "pattern": "explorer"
        },
        {
          "name": "mybonus",
          "pattern": "explorer/mybonus"
        },
        {
          "name": "managebonus",
          "pattern": "explorer/managebonus"
        },
        {
          "name": "services",
          "pattern": "explorer/services"
        },
        {
          "name": "sickness",
          "pattern": "sickness"
        },
        {
          "name": "leaveadmin",
          "pattern": "leavemanagement"
        },
        {
          "name": "documents",
          "pattern": "documents"
        },
        {
          "name": "tsreport",
          "pattern": "timesheetreporting"
        },
        {
          "name": "utilisation",
          "pattern": "utilisation"
        },
        {
          "name": "resources",
          "pattern": "manageresources"
        },
        {
          "name": "clients",
          "pattern": "manageclients"
        },
        {
          "name": "projects",
          "pattern": "manageprojects"
        }
      ]
    },
    "rootView": {
      "viewName": "bsx.hrx.hrx2026.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "hrx2026"
  }
}